# 由 docker-compose-prod.yml 挂载；DOMAIN 来自 env 文件（staging / production 各自的 .env.*）。
#
# 证书来源用**全局选项**而不是站点里的 tls 指令：
#   站点里的 `tls {$TLS_ARG:}` 在变量为空时会展开成光秃秃的 `tls`（缺参数），
#   caddy 直接拒绝启动——而生产恰好就是「留空 = 走公网 ACME」。
# 全局选项 `local_certs` 则可以整行消失：置了 = 内置 CA 自签（预发），
# 留空 = 该行是空的，什么都不设，caddy 对公网域名自动走 Let's Encrypt（生产）。
#
# staging 置 local_certs：80/443 被前身系统占着，ACME HTTP-01 签不出来。
# production 留空：80/443 已让出来，公网 ACME 签得出来。
{
	{$TLS_LOCAL_CERTS:}
}

{$DOMAIN} {
	encode zstd gzip

	# SSE 必须关缓冲：agent 运行流（langgraph-sdk 兼容帧）与进度推送
	# 依赖服务端即时下发，缓冲会把流攒成批
	reverse_proxy app:3940 {
		flush_interval -1
	}

	header {
		-Server
	}

	log {
		output stdout
		format json
	}
}
