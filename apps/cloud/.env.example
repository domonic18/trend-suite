# ============================================================
# 云端运行配置样例。
# 本地开发：cp .env.example .env（compose 起的 PG 默认口令见 docker-compose.yml）。
# 服务器部署：参照本文件准备 .env.staging 与 .env.prod（见 docs/ops/01部署Runbook.md），
#            IMAGE_TAG / TREND_IMAGE_REPO 由 deploy.sh 发布时自动写入，不要手工维护。
# ============================================================

# ---- 应用 ----
# 运行环境（local / staging / production）
APP_ENV=local
HOST=127.0.0.1
PORT=3940

# ---- 数据库 ----
# 本地默认走 docker compose 起的 PG；测试库必须与开发库不同（测试会清空目标库）
DATABASE_URL=postgres://trend_suite:trend_suite@127.0.0.1:5435/trend_suite
TEST_DATABASE_URL=postgres://trend_suite:trend_suite@127.0.0.1:5435/trend_suite_test

# ---- 以下仅服务器部署需要（.env.staging / .env.prod）----
# compose 内 db 服务初始化与 DATABASE_URL 拼装共用；密码含特殊字符需 URL 编码
#POSTGRES_USER=trend_suite
#POSTGRES_PASSWORD=
#POSTGRES_DB=trend_suite

# 对外域名（caddy 自动签发证书）——按环境填写真实域名，仓库存占位
# 预发：<staging-domain>   生产：<prod-domain>
#DOMAIN=<staging-domain>

# caddy 宿主端口：staging 8080/8443；production 80/443（沿用前身系统让出的端口，
# 切换时前身系统先迁到 8081/8443 让位，见 docs/ops/01部署Runbook.md §3.1）
#HTTP_PORT=80
#HTTPS_PORT=443

# 媒体存储：生产定案 cos（腾讯云 COS，同地域内网，桶私有读）；local 仅开发测试。见 arch/05 §3.2
# 服务器磁盘只做转码临时工作区（workspace/pipeline），媒体产物上传 COS 后即清理
#MEDIA_STORAGE=cos
#COS_BUCKET=
#COS_REGION=
#COS_ENDPOINT=            # 同地域内网端点
#COS_SECRET_ID=
#COS_SECRET_KEY=
# 本地模式（开发测试）：
#MEDIA_STORAGE=local
#MEDIA_LOCAL_DIR=/media
#PIPELINE_HLS_DIR=/media/hls

# ---- 以下由 deploy.sh 自动维护，勿手工改 ----
#IMAGE_TAG=
#TREND_IMAGE_REPO=
