{
  "name": "@trend-suite/cloud",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3940 --hostname 127.0.0.1",
    "dev:all": "node --run dev & APP_ROLE=worker node --run worker & wait",
    "worker": "node --env-file-if-exists=.env --conditions=react-server --import tsx src/worker.ts",
    "check": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "start:all": "PORT=3940 node --run start & APP_ROLE=worker node --run worker & wait",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\" \"src/**/*.test.ts\"",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/db/migrate.ts",
    "seed": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/db/seed.ts",
    "loadtest": "node scripts/ops/load-test.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.3.7",
    "@langchain/langgraph": "^1.6.1",
    "@langchain/langgraph-checkpoint": "^1.2.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.4",
    "@langchain/langgraph-sdk": "^1.9.23",
    "@trend-suite/contracts": "workspace:*",
    "@trend-suite/dsl": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "deepagents": "1.17.0",
    "hls.js": "^1.7.4",
    "klinecharts": "^10.1.0",
    "langchain": "^1.6.4",
    "langsmith": "^0.11.0",
    "lucide-react": "^1.80.0",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^2.1.9",
    "server-only": "^0.0.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.1",
    "tsx": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0"
  }
}
