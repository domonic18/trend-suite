# ============================================================
# staging（测试环境）服务器配置样例 —— 真实文件为服务器上的 .env.staging，不入库。
# 键集合与 docker-compose-prod.yml / deploy.sh 的消费一一对应；
# 值一律占位符（开源仓库脱敏纪律，见 AGENTS.md 硬约束 8），真实值走内部渠道下发。
# IMAGE_TAG / TREND_IMAGE_REPO 由 deploy.sh 发布时自动写入，不要手工维护。
# ============================================================

# ---- 数据库（compose db 服务初始化 + DATABASE_URL 拼装共用；密码含特殊字符需 URL 编码）----
POSTGRES_USER=trend_suite
POSTGRES_PASSWORD=<staging-db-password>
POSTGRES_DB=trend_suite

# ---- 初始管理员（发布时 seed 步骤幂等创建；留空则不创建管理账号）----
# 发布前必须改成真实值：占位符不符合用户名规则，seed 会中止发布
BOOTSTRAP_ADMIN_USERNAME=<staging-admin-username>
BOOTSTRAP_ADMIN_PASSWORD=<staging-admin-password>

# ---- 对外访问（caddy）----
# 预发域名
DOMAIN=<staging-domain>
# staging 用 8080/8443（80/443 被前身系统占着，ACME 签不出来 → 内置 CA 自签）
HTTP_PORT=8080
HTTPS_PORT=8443
# local_certs = caddy 内置 CA 自签；留空 = 公网 ACME
TLS_LOCAL_CERTS=local_certs

# ---- 媒体存储 ----
# 预发可沿用 local 模式（媒体落盘），定案再切 cos
MEDIA_STORAGE=local
# compose 挂载的宿主媒体目录（local 模式下容器 /media 的落点）
MEDIA_HOST_DIR=./workspace/media
# 直传凭据签名密钥（arch/05 §3.1）：未配置则上传接口 503
MEDIA_UPLOAD_SECRET=<staging-media-upload-secret>
#MEDIA_STORAGE=cos
#COS_BUCKET=<staging-cos-bucket>
#COS_REGION=<cos-region>
#COS_ENDPOINT=<cos-internal-endpoint>
#COS_SECRET_ID=<cos-secret-id>
#COS_SECRET_KEY=<cos-secret-key>

# ---- 以下由 deploy.sh 自动维护，勿手工改 ----
#IMAGE_TAG=main-<sha>
#TREND_IMAGE_REPO=<registry>/<namespace>/trend-suite
